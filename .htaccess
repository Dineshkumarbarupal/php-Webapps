Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep application code, runtime data and development files out of direct web access.
    RewriteRule ^(?:app|storage|\.git)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\..*)?|\.gitignore|README\.md|server\.php)$ - [F,L,NC]

    # Serve real files (CSS/JS/images) normally and route other URLs to the PHP app.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>
